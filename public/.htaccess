# SPA shell: never cache index.html, so every deploy is visible on the
# very next page load instead of waiting out a stale server/CDN cache.
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Vite-built JS/CSS/font assets are content-hashed (filename changes
  # on every build), so they're safe to cache aggressively forever.
  <FilesMatch "\.(js|css|woff2?|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
