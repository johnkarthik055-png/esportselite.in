rules_version = '2';

/*
 * Esports Elite — Firestore Security Rules
 * ---------------------------------------------------------------------------
 * Historically these rules lived ONLY in the Firebase Console and were
 * mirrored as comment blocks at the top of the components that use each
 * collection (firebase.js, MapKnowledge.jsx, Scheduler.jsx, Tournaments.jsx,
 * ProjectLogTab.jsx, TeamPractice.jsx, AICoach.jsx).
 *
 * This file consolidates every one of those documented blocks into a single
 * deployable ruleset and ADDS the subscription carve-out required by the
 * Razorpay integration:
 *
 *   users/{uid}.subscription  — readable by its owner, but NEVER writable by
 *   any client. It is written only by functions/razorpayWebhook.js through
 *   the Admin SDK, which bypasses these rules entirely.
 *
 * BEFORE PUBLISHING: open Firebase Console → Firestore → Rules and diff this
 * file against what is live. It is reconstructed from in-repo comments and
 * may be missing a collection that was added directly in the console. Deploy
 * with either:
 *   firebase deploy --only firestore:rules
 * (after adding a "firestore" block to firebase.json), or paste into the
 * console editor.
 * ---------------------------------------------------------------------------
 */

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /* Admin allow-list — keep in sync with the comment blocks in
       ProjectLogTab.jsx / MapKnowledge.jsx / Tournaments.jsx. */
    function isAdmin() {
      return isSignedIn() && request.auth.token.email in [
        'karthikreddyy2010@gmail.com',
        'johnkarthik055@gmail.com'
      ];
    }

    /* True when this update does NOT touch the protected `subscription` field. */
    function subscriptionUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['subscription']);
    }

    /* ===================================================================
       USERS — per-user private data (profile, trial, xp, streak, igns,
       classicStats, coachSessions, schedules, matches, …)
       =================================================================== */
    match /users/{userId} {
      allow read:   if isOwner(userId);
      allow create: if isOwner(userId);
      allow delete: if isOwner(userId);

      /* Owner may update anything on their own doc EXCEPT `subscription`,
         which only the Razorpay webhook (Admin SDK) may set. */
      allow update: if isOwner(userId) && subscriptionUnchanged();

      /* All subcollections remain fully owner-read/write. */
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    /* ===================================================================
       PROJECT LOG — Admin Panel running log (ProjectLogTab.jsx)
       =================================================================== */
    match /projectLog/{entryId} {
      allow read, write: if isAdmin();
    }

    /* ===================================================================
       APP CONFIG — maintenance flag etc. (App.jsx)
       =================================================================== */
    match /app_config/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    /* ===================================================================
       MAP DATA — Map Knowledge pins/zones (MapKnowledge.jsx)
       =================================================================== */
    match /mapData/{mapId}/{collection}/{doc} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    /* ===================================================================
       TOURNAMENTS (Tournaments.jsx)
       =================================================================== */
    match /tournaments/{tournamentId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();

      match /matches/{matchId} {
        allow read:  if isSignedIn();
        allow write: if isAdmin();
      }
    }

    /* ===================================================================
       TEAMS — roster, announcements, practice, etc. (TeamPractice.jsx,
       team.js, useTeam.js)
       =================================================================== */
    match /teams/{teamId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() &&
        (request.auth.uid == resource.data.ownerId || isAdmin());

      match /{subcollection=**} {
        allow read, write: if isSignedIn();
      }
    }
  }
}
